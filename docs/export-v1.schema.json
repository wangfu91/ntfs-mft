{
  "$defs": {
    "ExportDiagnostic": {
      "description": "Structured offline limitation with optional nested read error.",
      "properties": {
        "attribute_type": {
          "description": "Affected NTFS type code, if known.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "code": {
          "description": "Stable snake_case issue code, documented in the schema guide.",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original extension-read failure."
        },
        "record_number": {
          "description": "Physical record where the issue was observed.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "Full referenced file identifier for extension-read failures."
        }
      },
      "required": [
        "record_number",
        "code"
      ],
      "type": "object"
    },
    "ExportError": {
      "description": "Stable error category plus best available source location.",
      "properties": {
        "category": {
          "description": "`io`, `parse`, or `other`. Diagnostic text is not a machine contract.",
          "type": "string"
        },
        "message": {
          "description": "Human-readable original error.",
          "type": "string"
        },
        "record_number": {
          "description": "Record slot if known; never inferred from iterator position.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "reported_offset": {
          "description": "Offset reported by an error without a known address space.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "volume_offset": {
          "description": "Original volume byte offset if the error supplies one.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "message"
      ],
      "type": "object"
    },
    "ExportExternalPayload": {
      "description": "Observed non-resident payload outside the offline input.",
      "properties": {
        "attribute_id": {
          "description": "Instance ID within that record.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "attribute_type": {
          "description": "NTFS attribute type code.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "record_number": {
          "description": "Physical record number as decimal.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "record_number",
        "attribute_type",
        "attribute_id"
      ],
      "type": "object"
    },
    "ExportItemV1": {
      "description": "Kind of item in a version-one stream.",
      "oneOf": [
        {
          "description": "Successfully parsed metadata, potentially partial.",
          "properties": {
            "data": {
              "$ref": "#/$defs/ExportRecordV1"
            },
            "type": {
              "const": "record",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "Item-level scan error.",
          "properties": {
            "data": {
              "$ref": "#/$defs/ExportError"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "ExportLink": {
      "description": "One retained file-name link. Namespace is the scanner's normalized numeric value.",
      "properties": {
        "name": {
          "$ref": "#/$defs/ExportName",
          "description": "Leaf name."
        },
        "namespace": {
          "description": "0 POSIX, 1 Win32, 2 DOS, 3 Win32/DOS; original unknown codes are unavailable.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "parent": {
          "$ref": "#/$defs/ExportReference",
          "description": "Full parent reference, including sequence."
        }
      },
      "required": [
        "parent",
        "namespace",
        "name"
      ],
      "type": "object"
    },
    "ExportMetadata": {
      "description": "Category-level evidence; stored separately from default-valued scan fields.",
      "properties": {
        "alternate_data_streams": {
          "$ref": "#/$defs/FieldState",
          "description": "Named data evidence."
        },
        "data_run_summary": {
          "$ref": "#/$defs/FieldState",
          "description": "Run summary evidence."
        },
        "dos_links_collected": {
          "description": "Whether DOS aliases were requested; null means unknown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "file_names": {
          "$ref": "#/$defs/FieldState",
          "description": "Names and selected-name timestamp evidence."
        },
        "reparse_point": {
          "$ref": "#/$defs/FieldState",
          "description": "Reparse-point attribute evidence, not a tag copied from FILE_NAME."
        },
        "standard_information": {
          "$ref": "#/$defs/FieldState",
          "description": "Standard-information attribute evidence."
        },
        "unnamed_data": {
          "$ref": "#/$defs/FieldState",
          "description": "Unnamed data evidence."
        }
      },
      "required": [
        "standard_information",
        "file_names",
        "unnamed_data",
        "alternate_data_streams",
        "reparse_point",
        "data_run_summary"
      ],
      "type": "object"
    },
    "ExportName": {
      "description": "Lossless supplied name plus an explicitly non-authoritative readable form.",
      "properties": {
        "display": {
          "description": "Replacement characters may occur here; use `raw` for roundtrips.",
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/NameUnits",
          "description": "Exact supplied representation, independently readable on any platform."
        }
      },
      "required": [
        "display",
        "raw"
      ],
      "type": "object"
    },
    "ExportPath": {
      "description": "Optional caller-supplied path evidence. Export never builds a directory tree.",
      "oneOf": [
        {
          "description": "No resolver was invoked.",
          "properties": {
            "state": {
              "const": "not_requested",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "Resolver could not produce a path; a leaf name is not substituted.",
          "properties": {
            "state": {
              "const": "unresolved",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "A complete caller-supplied path.",
          "properties": {
            "path": {
              "$ref": "#/$defs/ExportName",
              "description": "Supplied path, in OS encoding."
            },
            "state": {
              "const": "resolved",
              "type": "string"
            }
          },
          "required": [
            "state",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "A caller-supplied partial path.",
          "properties": {
            "path": {
              "$ref": "#/$defs/ExportName",
              "description": "Supplied path fragment."
            },
            "state": {
              "const": "partial",
              "type": "string"
            }
          },
          "required": [
            "state",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "ExportRecordV1": {
      "description": "Version-one record representation. This is not a serialized scanner struct.",
      "properties": {
        "alternate_streams": {
          "description": "Retained named streams, in original order; no deduplication or flattening.",
          "items": {
            "$ref": "#/$defs/ExportStream"
          },
          "type": "array"
        },
        "base_record_number": {
          "description": "Base record number as supplied by the scanner; zero is its base-record sentinel.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "base_sequence_number": {
          "description": "Always null for current adapters: scanner has discarded base sequence bits.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "compressed": {
          "description": "Scanner's unnamed-stream compressed indicator.",
          "type": "boolean"
        },
        "data_runs": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportRuns"
            },
            {
              "type": "null"
            }
          ],
          "description": "Summary when available; see metadata for completeness."
        },
        "diagnostics": {
          "description": "Offline diagnostics; empty raw-scan diagnostics do not prove completeness.",
          "items": {
            "$ref": "#/$defs/ExportDiagnostic"
          },
          "type": "array"
        },
        "directory": {
          "description": "Record marked as a directory.",
          "type": "boolean"
        },
        "encrypted": {
          "description": "Scanner's unnamed-stream encrypted indicator.",
          "type": "boolean"
        },
        "external_payloads": {
          "description": "Observed external payload headers. Empty does not establish absence.",
          "items": {
            "$ref": "#/$defs/ExportExternalPayload"
          },
          "type": "array"
        },
        "file_attributes": {
          "description": "Raw SI attribute flags, including unknown bits.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "file_name_times": {
          "$ref": "#/$defs/ExportTimes",
          "description": "Selected FILE_NAME timestamps only; other links' times are unavailable."
        },
        "flags": {
          "description": "Raw FILE header flags, including unknown bits.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "hard_link_count": {
          "description": "FILE header hard-link count; not necessarily equal to retained link count.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "links": {
          "description": "Every link retained by the scanner, in original order.",
          "items": {
            "$ref": "#/$defs/ExportLink"
          },
          "type": "array"
        },
        "metadata": {
          "$ref": "#/$defs/ExportMetadata",
          "description": "Evidence for presence, completeness, and collection choices."
        },
        "name_fidelity": {
          "description": "`ntfs_utf16_preserved` for exact original NTFS code units.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/ExportPath",
          "description": "Selected-name path evidence supplied by the caller."
        },
        "record_number": {
          "description": "Supplied physical record number as decimal, independent of the reference.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ExportReference",
          "description": "Full identifier, including sequence."
        },
        "reparse_point": {
          "description": "Scanner's reparse-point indicator.",
          "type": "boolean"
        },
        "reparse_tag": {
          "description": "Scanner's tag, which may originate from FILE_NAME.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "selected_name": {
          "$ref": "#/$defs/ExportLink",
          "description": "Selected link; may contain defaults when names are absent or unknown."
        },
        "sequence_number": {
          "description": "Supplied record-header sequence number.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "description": "`raw_scan` or `offline_stream`.",
          "type": "string"
        },
        "sparse": {
          "description": "Scanner's unnamed-stream sparse indicator.",
          "type": "boolean"
        },
        "standard_information_times": {
          "$ref": "#/$defs/ExportTimes",
          "description": "Standard-information timestamps; interpret using metadata."
        },
        "stream_offset": {
          "description": "Logical extracted-stream offset; never a volume offset.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "unnamed_stream": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportStream"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when no unnamed data was observed, not necessarily proven absent."
        },
        "used": {
          "description": "Record marked in use.",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "record_number",
        "sequence_number",
        "reference",
        "base_record_number",
        "hard_link_count",
        "flags",
        "used",
        "directory",
        "reparse_point",
        "selected_name",
        "links",
        "standard_information_times",
        "file_name_times",
        "file_attributes",
        "sparse",
        "compressed",
        "encrypted",
        "alternate_streams",
        "metadata",
        "path",
        "diagnostics",
        "external_payloads",
        "name_fidelity"
      ],
      "type": "object"
    },
    "ExportReference": {
      "description": "A full NTFS reference with its record and sequence fields.",
      "properties": {
        "raw": {
          "description": "Full unsigned identifier as a decimal string.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "record_number": {
          "description": "Lower 48 bits of a standard reference, as a decimal string.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "sequence_number": {
          "description": "Upper 16 bits of a standard reference.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "raw",
        "record_number",
        "sequence_number"
      ],
      "type": "object"
    },
    "ExportRuns": {
      "description": "Run summary of the represented unnamed stream segment.",
      "properties": {
        "run_count": {
          "description": "Number of runs.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total_clusters": {
          "description": "Logical clusters, as a decimal string.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "run_count",
        "total_clusters"
      ],
      "type": "object"
    },
    "ExportStream": {
      "description": "Supported stream size and residency metadata.",
      "properties": {
        "allocated_size": {
          "description": "Allocated size in bytes, as reported by the scanner, as a decimal string.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportName"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null identifies the unnamed stream."
        },
        "real_size": {
          "description": "Logical size in bytes, as a decimal string.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "resident": {
          "description": "Whether data is resident in a FILE record.",
          "type": "boolean"
        }
      },
      "required": [
        "real_size",
        "allocated_size",
        "resident"
      ],
      "type": "object"
    },
    "ExportTimes": {
      "description": "Four timestamps from one attribute category.",
      "properties": {
        "accessed": {
          "$ref": "#/$defs/ExportTimestamp",
          "description": "Last access time."
        },
        "created": {
          "$ref": "#/$defs/ExportTimestamp",
          "description": "Creation time."
        },
        "mft_modified": {
          "$ref": "#/$defs/ExportTimestamp",
          "description": "MFT record modification time."
        },
        "modified": {
          "$ref": "#/$defs/ExportTimestamp",
          "description": "File modification time."
        }
      },
      "required": [
        "created",
        "modified",
        "mft_modified",
        "accessed"
      ],
      "type": "object"
    },
    "ExportTimestamp": {
      "description": "A FILETIME with all 100-nanosecond ticks retained.",
      "properties": {
        "status": {
          "$ref": "#/$defs/TimestampStatus",
          "description": "Interpretation of the readable form."
        },
        "ticks": {
          "description": "Unsigned ticks since 1601-01-01, as a decimal string.",
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "utc": {
          "description": "UTC RFC 3339 with exactly seven fractional digits, or null outside range.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ticks",
        "status"
      ],
      "type": "object"
    },
    "FieldState": {
      "description": "Presence and completeness of the supported metadata, not file contents.",
      "oneOf": [
        {
          "const": "unknown",
          "description": "No reliable inspection evidence is available.",
          "type": "string"
        },
        {
          "const": "not_collected",
          "description": "Collection was disabled by the caller.",
          "type": "string"
        },
        {
          "const": "not_observed",
          "description": "No value was observed; absence is not established.",
          "type": "string"
        },
        {
          "const": "absent",
          "description": "Absence was established by complete inspection.",
          "type": "string"
        },
        {
          "const": "present",
          "description": "Supported metadata was inspected completely.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "Some metadata was observed but inspection was incomplete.",
          "type": "string"
        }
      ]
    },
    "NameUnits": {
      "description": "Exact UTF-16 name or native platform representation of a supplied path.",
      "oneOf": [
        {
          "description": "NTFS or Windows UTF-16 units, including unpaired surrogates, on any host.",
          "properties": {
            "encoding": {
              "const": "windows_utf16",
              "type": "string"
            },
            "units": {
              "items": {
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "encoding",
            "units"
          ],
          "type": "object"
        },
        {
          "description": "Unix OS bytes. These are not the original NTFS UTF-16 bytes.",
          "properties": {
            "encoding": {
              "const": "unix_bytes",
              "type": "string"
            },
            "units": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "encoding",
            "units"
          ],
          "type": "object"
        }
      ]
    },
    "TimestampStatus": {
      "description": "Why readable timestamp text is unavailable or ambiguous.",
      "oneOf": [
        {
          "const": "formatted",
          "description": "Nonzero ticks formatted as UTC.",
          "type": "string"
        },
        {
          "const": "zero_ambiguous",
          "description": "Zero may mean an unset/default value or the FILETIME epoch; consult metadata.",
          "type": "string"
        },
        {
          "const": "out_of_range",
          "description": "Outside four-digit-year RFC 3339 representation.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Versioned, independently decodable JSONL item. Unknown versions are rejected.",
  "oneOf": [
    {
      "$ref": "#/$defs/ExportItemV1",
      "description": "The version-one schema.",
      "properties": {
        "schema_version": {
          "const": "1",
          "type": "string"
        }
      },
      "required": [
        "schema_version"
      ],
      "type": "object"
    }
  ],
  "title": "ExportItem"
}
